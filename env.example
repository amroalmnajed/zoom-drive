# Copy this file to ".env" and fill in your real values. Never commit .env.

# --- Zoom Server-to-Server OAuth app (marketplace.zoom.us -> Manage -> your app -> App Credentials)
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Email (or user ID) of the Zoom user whose cloud recordings you want. "me" does NOT work for S2S apps.
ZOOM_USER_ID=your_zoom_user_id

# --- Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Google Drive Folder IDs
# Replace these with your actual Google Drive folder IDs
FOLDER_ID_1=your_drive_folder_id_1
FOLDER_ID_2=your_drive_folder_id_2
FOLDER_ID_3=your_drive_folder_id_3
FOLDER_ID_4=your_drive_folder_id_4

# --- Optional overrides
LOOKBACK_DAYS=7
LOCAL_TIMEZONE=Africa/Cairo
GOOGLE_AUTH_MODE=oauth
UPLOAD_CHUNK_MB=16

# --- Retry and timeout settings (optional)
MAX_RETRIES=6
BACKOFF_BASE_SECONDS=2
BACKOFF_MAX_SECONDS=60
HTTP_TIMEOUT_SECONDS=120
ZOOM_RATE_LIMIT=10
